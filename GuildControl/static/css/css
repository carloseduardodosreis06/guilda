```css
/* Configurações Globais do GuildControl */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0b111e;
    color: #ffffff;
    min-height: 100vh;
}

/* Inputs Padronizados */
input, select, textarea {
    width: 100%;
    background-color: #1f2b42;
    border: 1px solid #334464;
    border-radius: 8px;
    padding: 12px;
    color: #ffffff;
    font-size: 14px;
    outline: none;
    transition: 0.3s;
}

input:focus, select:focus, textarea:focus {
    border-color: #a855f7;
    box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.2);
}

/* Botões Roxos Padronizados */
.btn-primary {
    background-color: #9333ea;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 14px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 4px 12px rgba(147, 51, 234, 0.3);
}

.btn-primary:hover {
    background-color: #a855f7;
    transform: translateY(-1px);
}
```
